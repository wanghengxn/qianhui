---
import type { SpecRow } from '@/data/specs';

interface Props {
  rows: SpecRow[];
  caption?: string;
  columns?: [string, string, string];
}

const { rows, caption, columns = ['Item', 'Sizes', 'Construction'] } = Astro.props;
---

<div class="overflow-x-auto">
  {caption && <p class="mb-2 text-xs text-ink-600">{caption}</p>}
  <table class="w-full min-w-[40rem] border-collapse text-sm">
    <thead>
      <tr class="border-b border-line text-left text-xs uppercase tracking-wide text-ink-600">
        <th scope="col" class="py-3 pr-4 font-semibold">{columns[0]}</th>
        <th scope="col" class="py-3 pr-4 font-semibold">{columns[1]}</th>
        <th scope="col" class="py-3 font-semibold">{columns[2]}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-b border-line align-top">
            <th scope="row" class="py-3 pr-4 text-left font-medium text-ink-900">
              {row.item}
            </th>
            <td class="py-3 pr-4 text-ink-600">{row.sizes}</td>
            <td class="py-3 text-ink-600">{row.spec}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
