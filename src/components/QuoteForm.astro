---
import { CATEGORY_PAGES, PRODUCT_PAGES, SITE } from '@/config/site';

const productOptions = [...CATEGORY_PAGES, ...PRODUCT_PAGES];
---

{
  /*
   * 提交到 Formspree：https://formspree.io/f/xvkabdgo
   * 用 fetch 提交（Accept: application/json），成功后在本页显示提示，不跳转外部页面。
   * 禁用 JS 时退化为原生 POST，会落到 Formspree 自己的 thanks 页。
   * 字段不要删减：`business_type` 是唯一能量化 B 端占比的字段（plan.md 附录 A）。
   */
}
<form class="grid gap-5" action="https://formspree.io/f/xvkabdgo" method="POST" data-formspree>
  <input type="hidden" name="_subject" value="New quote request from qian-hui.com" />
  <input type="hidden" name="source_page" value={Astro.url.pathname} />

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid gap-1.5">
      <span class="text-sm font-medium">
        Business type <span class="text-red-600" aria-hidden="true">*</span>
      </span>
      <select name="business_type" required class="rounded border border-line px-3 py-2.5 text-sm">
        <option value="">Select…</option>
        {SITE.businessTypes.map((type) => <option value={type}>{type}</option>)}
      </select>
    </label>

    <label class="grid gap-1.5">
      <span class="text-sm font-medium">
        Destination country <span class="text-red-600" aria-hidden="true">*</span>
      </span>
      <input
        type="text"
        name="destination"
        required
        autocomplete="country-name"
        class="rounded border border-line px-3 py-2.5 text-sm"
      />
    </label>
  </div>

  <fieldset class="grid gap-2">
    <legend class="mb-1 text-sm font-medium">Products of interest</legend>
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        productOptions.map((item) => (
          <label class="flex items-center gap-2 text-sm text-ink-600">
            <input type="checkbox" name="products" value={item.label} class="size-4 rounded border-line" />
            {item.label}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid gap-1.5">
      <span class="text-sm font-medium">Estimated quantity</span>
      <input
        type="text"
        name="quantity"
        placeholder="e.g. 500 sets / 2 containers"
        class="rounded border border-line px-3 py-2.5 text-sm"
      />
    </label>

    <label class="grid gap-1.5">
      <span class="text-sm font-medium">
        Email <span class="text-red-600" aria-hidden="true">*</span>
      </span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        class="rounded border border-line px-3 py-2.5 text-sm"
      />
    </label>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid gap-1.5">
      <span class="text-sm font-medium">WhatsApp</span>
      <input
        type="tel"
        name="whatsapp"
        autocomplete="tel"
        class="rounded border border-line px-3 py-2.5 text-sm"
      />
    </label>

    <label class="grid gap-1.5">
      <span class="text-sm font-medium">Company</span>
      <input type="text" name="company" autocomplete="organization" class="rounded border border-line px-3 py-2.5 text-sm" />
    </label>
  </div>

  <label class="grid gap-1.5">
    <span class="text-sm font-medium">Requirements</span>
    <textarea
      name="message"
      rows="4"
      class="rounded border border-line px-3 py-2.5 text-sm"
      placeholder="Sizes, GSM / thread count, certifications, delivery window…"
    ></textarea>
  </label>

  {/* 蜜罐：真人看不见，机器人会填。Formspree 只认 _gotcha 这个名字 */}
  <div class="hidden" aria-hidden="true">
    <label>Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button
      type="submit"
      class="rounded-md bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-60"
    >
      Send inquiry
    </button>
    <p class="text-xs text-ink-600">Trade inquiries only. We reply by email on business days.</p>
  </div>

  <p data-form-status role="status" aria-live="polite" class="hidden text-sm"></p>
</form>

<div
  data-form-toast
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 top-4 z-50 flex -translate-y-2 justify-center px-4 opacity-0 transition duration-300 ease-out"
>
  <div class="pointer-events-auto rounded-lg border border-line bg-white px-6 py-4 text-center shadow-xl">
    <p class="text-sm font-semibold text-ink-900">Thank you. Your inquiry is in.</p>
    <p class="mt-1 text-xs text-ink-600">We reply by email on business days.</p>
  </div>
</div>

<script>
  const toast = document.querySelector<HTMLElement>('[data-form-toast]');
  let toastTimer: number | undefined;

  const hideToast = () => {
    if (!toast) return;
    toast.classList.add('opacity-0', '-translate-y-2');
    toast.classList.remove('opacity-100', 'translate-y-0');
    toast.setAttribute('aria-hidden', 'true');
  };

  const showToast = () => {
    if (!toast) return;
    toast.classList.remove('opacity-0', '-translate-y-2');
    toast.classList.add('opacity-100', 'translate-y-0');
    toast.removeAttribute('aria-hidden');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(hideToast, 5000);
  };

  const forms = document.querySelectorAll<HTMLFormElement>('form[data-formspree]');

  forms.forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');

    const showStatus = (message: string, isError: boolean) => {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden', 'text-red-700', 'text-ink-600');
      status.classList.add(isError ? 'text-red-700' : 'text-ink-600');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const originalLabel = button?.textContent ?? '';
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }
      if (status) {
        status.textContent = '';
        status.classList.add('hidden');
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          if (status) {
            status.textContent = '';
            status.classList.add('hidden');
          }
          showToast();
          return;
        }

        const data = await response.json().catch(() => null);
        const detail = data?.errors?.map((item: { message: string }) => item.message).join(' ');
        showStatus(detail || 'The form did not send. Please email us directly.', true);
      } catch {
        showStatus('The form did not send. Please email us directly.', true);
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = originalLabel;
        }
      }
    });
  });
</script>
