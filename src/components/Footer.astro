---
import { CATEGORY_PAGES, PRODUCT_PAGES, SITE, SUPPLIER_PAGES } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line bg-surface">
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-base font-semibold text-ink-900">{SITE.name}</p>
      <p class="mt-2 text-sm text-ink-600">{SITE.legalName}</p>
      {SITE.contact.address && <p class="mt-2 text-sm text-ink-600">{SITE.contact.address}</p>}
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-900">Suppliers</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-600">
        {
          SUPPLIER_PAGES.map((item) => (
            <li>
              <a class="hover:text-ink-900" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-900">Products</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-600">
        {
          [...CATEGORY_PAGES, ...PRODUCT_PAGES].map((item) => (
            <li>
              <a class="hover:text-ink-900" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-ink-900">Company</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-600">
        <li><a class="hover:text-ink-900" href="/company/">About Us</a></li>
        <li><a class="hover:text-ink-900" href="/certifications/">Certifications</a></li>
        <li><a class="hover:text-ink-900" href="/guides/">Guides</a></li>
        <li><a class="hover:text-ink-900" href="/request-a-quote/">Request a Quote</a></li>
      </ul>
      <ul class="mt-4 space-y-2 text-sm text-ink-600">
        {SITE.contact.email && <li><a class="hover:text-ink-900" href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></li>}
        {SITE.contact.phone && <li><a class="hover:text-ink-900" href={`tel:${SITE.contact.phone.replace(/[^\d+]/g, '')}`}>{SITE.contact.phone}</a></li>}
        {SITE.contact.whatsapp && <li><a class="hover:text-ink-900" href={`https://wa.me/${SITE.contact.whatsapp}`}>WhatsApp</a></li>}
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-ink-600 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalName}. All rights reserved.</p>
      <p>Wholesale only. Trade accounts, MOQ applies.</p>
    </div>
  </div>
</footer>
