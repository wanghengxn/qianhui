---
interface Item {
  name: string;
  /** 不带尾斜杠；最后一项传 undefined 表示当前页 */
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-ink-600">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a class="hover:text-ink-900" href={item.href}>
              {item.name}
            </a>
          ) : (
            <span class="text-ink-900" aria-current="page">
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
