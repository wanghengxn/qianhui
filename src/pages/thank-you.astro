---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { pageTitle } from '@/lib/seo';
---

<BaseLayout title={pageTitle('Inquiry received')} noindex>
  <section class="container-page py-20">
    <h1 class="text-3xl font-semibold tracking-tight">Inquiry received</h1>
    <p class="mt-3 max-w-xl leading-relaxed text-ink-600">
      We read every inquiry ourselves and reply by email on business days, China time. If the
      spec is close to something we already run, the first reply carries a price; if it is not,
      it carries questions.
    </p>
    <p class="mt-3 max-w-xl leading-relaxed text-ink-600">
      Forgot the sizes, the quantity or the delivery window? Send it to
      {SITE.contact.email ? (
        <a class="font-semibold underline" href={`mailto:${SITE.contact.email}`}>
          {SITE.contact.email}
        </a>
      ) : (
        'us'
      )}{' '}
      and quote the subject line of the confirmation email.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/" class="rounded-md border border-line px-5 py-3 text-sm font-semibold">
        Back to home
      </a>
      <a href="/request-a-quote/" class="rounded-md border border-line px-5 py-3 text-sm font-semibold">
        Send another inquiry
      </a>
    </div>
  </section>
</BaseLayout>
