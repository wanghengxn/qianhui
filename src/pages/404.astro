---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORY_PAGES } from '@/config/site';
import { pageTitle } from '@/lib/seo';
---

<BaseLayout title={pageTitle('Page not found')} noindex noCanonical>
  <section class="container-page py-20">
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-600">
      The page you requested does not exist. If you were looking for a product range, start
      below. If a link from us broke, tell us and we will fix it.
      <a href="/request-a-quote/" class="font-semibold underline">Send an inquiry</a>
    </p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {
        CATEGORY_PAGES.map((item) => (
          <li>
            <a href={item.href} class="rounded border border-line px-4 py-2 text-sm">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
